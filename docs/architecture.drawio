x="482" y="888"/></Array></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="cross-region backup&lt;br&gt;replication" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#00A4A6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1310" y="600" width="160" height="34" as="geometry"/></mxCell><mxCell id="c42" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="256" width="24" height="24" as="geometry"/></mxCell><mxCell id="c43" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="24" height="24" as="geometry"/></mxCell><mxCell id="c44" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="232" width="24" height="24" as="geometry"/></mxCell><mxCell id="c45" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="316" width="24" height="24" as="geometry"/></mxCell><mxCell id="c46" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="604" width="24" height="24" as="geometry"/></mxCell><mxCell id="c47" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="836" width="24" height="24" as="geometry"/></mxCell><mxCell id="c48" value="How it works" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1730" y="110" width="360" height="24" as="geometry"/></mxCell><mxCell id="c49" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="146" width="20" height="20" as="geometry"/></mxCell><mxCell id="c50" value="Writes stop on the company server, so nothing changes mid-copy." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="144" width="330" height="64" as="geometry"/></mxCell><mxCell id="c51" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="212" width="20" height="20" as="geometry"/></mxCell><mxCell id="c52" value="The database dump and every uploaded file go to S3 over HTTPS. Each file&#x27;s SHA-256 is checked." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="210" width="330" height="64" as="geometry"/></mxCell><mxCell id="c53" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="278" width="20" height="20" as="geometry"/></mxCell><mxCell id="c54" value="Run Command restores the dump into RDS from inside the VPC. There is no SSH." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="276" width="330" height="64" as="geometry"/></mxCell><mxCell id="c55" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="344" width="20" height="20" as="geometry"/></mxCell><mxCell id="c56" value="Row counts and an MD5 of every row must match on both sides before staff switch over." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="342" width="330" height="64" as="geometry"/></mxCell><mxCell id="c57" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="410" width="20" height="20" as="geometry"/></mxCell><mxCell id="c58" value="Backups and transaction logs replicate to Ireland continuously. S3 replicates every file." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="408" width="330" height="64" as="geometry"/></mxCell><mxCell id="c59" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1730" y="476" width="20" height="20" as="geometry"/></mxCell><mxCell id="c60" value="If London fails, one Terraform variable builds Ireland from the same module and restores the database." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1758" y="474" width="330" height="64" as="geometry"/></mxCell><mxCell id="c61" value="Measured" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1730" y="550" width="360" height="20" as="geometry"/></mxCell><mxCell id="c62" value="Cutover: 94 seconds of frozen writes. Every row and file matched.&lt;br&gt;Failover drill: serving from Ireland in 18 min 27 s. Data lost: more than 10 min of writes, set by backup replication lag." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1730" y="574" width="360" height="90" as="geometry"/></mxCell><mxCell id="c63" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1730" y="682" width="360" height="20" as="geometry"/></mxCell><mxCell id="c64" value="Grey line: migration and app traffic&lt;br&gt;Teal dashed: replication to the DR region&lt;br&gt;Dashed VPC: built only when failing over" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1730" y="706" width="360" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>